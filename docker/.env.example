# ── Database ───────────────────────────────────
POSTGRES_PASSWORD=change_me_in_production

# ── Clerk Auth ─────────────────────────────────
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# ── GYDS Chain ─────────────────────────────────
GYDS_CHAIN_ID=1337
GYDS_DOMAIN=rpc.yourdomain.com
GYDS_NODE_MODE=lite
GYDS_LOG_LEVEL=info

# ── Portainer stack ports ──────────────────────
GYDS_RPC_PORT=8545
GYDS_WS_PORT=8546
GYDS_P2P_PORT=30304

# ── Litenode data path (for Portainer bind mount)
GYDS_DATA_PATH=/opt/gyds/litenode

# ── Bootstrap nodes (comma-separated IPs/hosts) ─
GYDS_BOOTSTRAP_NODES=
