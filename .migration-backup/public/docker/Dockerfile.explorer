# GydsChain Explorer + Dashboard Dockerfile v2.1.0
# Multi-stage build with security hardening
# Domain: netlifegy.com | Chain ID: 13370
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies first for caching
COPY package.json bun.lock* ./
RUN npm install --production=false

# Copy source and build
COPY . .
RUN npm run build

# Production stage with hardened Nginx
FROM nginx:1.27-alpine

# Security: remove defaults, add tools
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf && \
    apk add --no-cache curl

# Copy built app
COPY --from=builder /app/dist /usr/share/nginx/html
COPY public/docker/nginx.conf /etc/nginx/conf.d/default.conf

# Security: set ownership and permissions
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -sf http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
