{
  "id": "com.gydschain.chaincore",
  "name": "ChainCore — GYDSchain Network",
  "short_name": "ChainCore",
  "description": "GYDSchain (GYDS) blockchain dashboard — monitor nodes, validators, DeFi, wallet, and governance from your phone or desktop.",
  "start_url": "/mobile",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#0d1117",
  "theme_color": "#00e5b4",
  "orientation": "portrait-primary",
  "lang": "en",
  "dir": "ltr",
  "icons": [
    { "src": "/gyds-coin.jpg", "sizes": "48x48",   "type": "image/jpeg" },
    { "src": "/gyds-coin.jpg", "sizes": "72x72",   "type": "image/jpeg" },
    { "src": "/gyds-coin.jpg", "sizes": "96x96",   "type": "image/jpeg" },
    { "src": "/gyds-coin.jpg", "sizes": "144x144", "type": "image/jpeg" },
    { "src": "/gyds-coin.jpg", "sizes": "192x192", "type": "image/jpeg", "purpose": "any" },
    { "src": "/gyds-coin.jpg", "sizes": "256x256", "type": "image/jpeg", "purpose": "maskable" },
    { "src": "/gyds-coin.jpg", "sizes": "512x512", "type": "image/jpeg", "purpose": "any maskable" }
  ],
  "categories": ["finance", "utilities", "productivity"],
  "shortcuts": [
    {
      "name": "Wallet",
      "short_name": "Wallet",
      "description": "Open your GYDS wallet",
      "url": "/wallet",
      "icons": [{ "src": "/gyds-coin.jpg", "sizes": "96x96" }]
    },
    {
      "name": "Block Explorer",
      "short_name": "Explorer",
      "description": "Browse blocks and transactions",
      "url": "/explorer",
      "icons": [{ "src": "/gyds-coin.jpg", "sizes": "96x96" }]
    },
    {
      "name": "DeFi / Swap",
      "short_name": "DeFi",
      "description": "GydsSwap DEX and DeFi tools",
      "url": "/defi",
      "icons": [{ "src": "/gyds-coin.jpg", "sizes": "96x96" }]
    },
    {
      "name": "Governance",
      "short_name": "DAO",
      "description": "Vote on proposals",
      "url": "/governance",
      "icons": [{ "src": "/gyds-coin.jpg", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "/wallet",
    "method": "GET",
    "params": {
      "text": "address"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+gyds",
      "url": "/wallet?address=%s"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.gydschain.chaincore",
      "id": "com.gydschain.chaincore"
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  }
}
