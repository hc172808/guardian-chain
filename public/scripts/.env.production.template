# ============================================================
# GYDSchain Production Environment Configuration v3.0.0
# Updated: 2026-06-18 (Post-Supabase migration)
# ============================================================
# This is the Express-only stack. No Supabase keys needed.
# Copy to: /var/www/gydschain/.env  (600 permissions)
# NEVER commit this file to version control!
# ============================================================

# ─── Required ───────────────────────────────────────────────
# PostgreSQL connection string (created by deploy-dashboard.sh)
# Format: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://gydschain:CHANGEME@localhost:5432/gydschain

# 32+ character random string for session encryption
# Generate: openssl rand -hex 32
SESSION_SECRET=CHANGEME

# ─── App ────────────────────────────────────────────────────
NODE_ENV=production
PORT=5001
APP_URL=https://app.netlifegy.com

# ─── Domain (auto-set by deploy-dashboard.sh) ──────────────
REPLIT_DOMAINS=app.netlifegy.com,netlifegy.com
SUBDOMAIN=app

# ─── Email (optional — SMTP for real email notifications) ───
# If not set, email verification tokens are logged to console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-password
# SMTP_FROM=noreply@netlifegy.com

# ─── Telegram (optional — for Telegram bot alerts) ─────────
# TELEGRAM_BOT_TOKEN=your-bot-token-here

# ─── WhatsApp (optional — admin configures via panel) ───────
# Admin sets these via Admin → WhatsApp tab. No env vars needed.

# ─── Wallet Encryption (optional) ───────────────────────────
# 64-character hex string for AES-256-GCM wallet encryption
# Generate: openssl rand -hex 32
# WALLET_ENCRYPTION_KEY=

# ─── hCaptcha (optional — for bot protection on register) ──
# HCAPTCHA_SECRET_KEY=

# ─── GitHub Webhook (optional) ──────────────────────────────
# GITHUB_WEBHOOK_SECRET=

# ─── Internal / Auto-populated ──────────────────────────────
# Do not modify these unless you know what you're doing.
# VITE_SUPABASE_URL=    # shim routes to Express API
# VITE_SUPABASE_PUBLISHABLE_KEY=  # not needed anymore
# VITE_SUPABASE_PROJECT_ID=  # not needed anymore
