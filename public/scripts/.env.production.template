# ============================================================
# GYDSchain Production Environment Configuration v2.2.0
# ============================================================
# Usage:
#   cp .env.production.template .env.production
#   # Fill in your values
#   docker compose -f public/docker/docker-compose.prod.yml --env-file .env.production up -d
#
# NEVER commit .env.production to version control!
# ============================================================

# ─── Supabase (Required) ────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# ─── Blockchain Node ─────────────────────────────────────────
GYDS_CHAIN_ID=13370
GYDS_NODE_TYPE=fullnode
GYDS_DATA_DIR=/var/lib/gydschain
GYDS_STORAGE_SIZE_GB=100
GYDS_MAX_PEERS=100
GYDS_LOG_LEVEL=info

# ─── RPC / WebSocket ─────────────────────────────────────────
GYDS_RPC_PORT=8546
GYDS_P2P_PORT=30303
GYDS_RPC_LOCAL=http://localhost:8546
# LAN endpoint (optional — your server's local IP:8546 — leave blank if not needed)
GYDS_RPC_LAN=

# ─── Mining ───────────────────────────────────────────────────
GYDS_MINING_ENABLED=false
GYDS_MINING_THREADS=4
# Replace with real wallet address for mining rewards
GYDS_MINING_WALLET=0xYourMiningWalletAddress

# ─── WireGuard VPN ────────────────────────────────────────────
GYDS_WG_PRIVATE_KEY=
GYDS_WG_PUBLIC_KEY=
GYDS_WG_SERVER_ENDPOINT=vpn.netlifegy.com
GYDS_WG_SERVER_PORT=51820
GYDS_WG_ALLOWED_IPS=10.0.0.0/24

# ─── Token Pricing ────────────────────────────────────────────
GYDS_GYD_PEGGED=true
GYDS_GYD_PRICE=1.0
GYDS_TOKEN_PRICE=0.0000001

# ─── Admin ────────────────────────────────────────────────────
GYDS_API_PORT=3030
# Replace with your admin wallet address
GYDS_ADMIN_WALLET=0xYourAdminWalletAddress
GYDS_FOUNDER_WALLET=0x0000000000000000000000000000000000000001

# ─── SSL / Domain ─────────────────────────────────────────────
GYDS_DOMAIN=netlifegy.com
# Email for Let's Encrypt SSL certificate registration
GYDS_SSL_EMAIL=admin@netlifegy.com

# ─── Docker / Database ────────────────────────────────────────
# Generate a secure password: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=gydschain
# Generate a secure password: openssl rand -hex 16
INDEXER_DB_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379
EXPLORER_PORT=3000

# ─── P2P Network ─────────────────────────────────────────────
GYDS_BOOTNODES=
GYDS_NAT_TYPE=any

# ─── Security / Firewall ─────────────────────────────────────
GYDS_FAIL2BAN_ENABLED=true
GYDS_FAIL2BAN_MAX_RETRIES=5
GYDS_FAIL2BAN_BAN_TIME=3600
GYDS_UFW_ENABLED=true
