# ============================================================
# GYDSchain Self-Hosting Environment Configuration v2.1.0
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control!
# ============================================================

# ─── Database (PostgreSQL) ────────────────────────────────
# Required: PostgreSQL connection string
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://gyds:your-password@localhost:5432/gydschain

# ─── Session Secret ───────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-64-char-string

# ─── Blockchain Node ──────────────────────────────────────
GYDS_CHAIN_ID=13370
GYDS_NODE_TYPE=fullnode
GYDS_DATA_DIR=/opt/gydschain/data
GYDS_STORAGE_SIZE_GB=50
GYDS_MAX_PEERS=100
GYDS_LOG_LEVEL=info

# ─── RPC / WebSocket ─────────────────────────────────────
GYDS_RPC_ENDPOINT=https://rpc.netlifegy.com
GYDS_RPC_PORT=8545
GYDS_RPC_BACKUP_1=https://rpc2.netlifegy.com
GYDS_RPC_BACKUP_2=https://rpc3.netlifegy.com
GYDS_RPC_LOCAL=http://localhost:8546
GYDS_WS_ENDPOINT=wss://ws.netlifegy.com
GYDS_WS_PORT=8546

# ─── Mining ───────────────────────────────────────────────
GYDS_MINING_ENABLED=false
GYDS_MINING_THREADS=4
GYDS_MINING_WALLET=0x6422d12bfaddee5142bfad21b3006a74d09017b1
GYDS_MINING_POOL_URL=

# ─── WireGuard VPN ────────────────────────────────────────
GYDS_WG_PRIVATE_KEY=
GYDS_WG_PUBLIC_KEY=
GYDS_WG_SERVER_ENDPOINT=vpn.netlifegy.com
GYDS_WG_SERVER_PORT=51820
GYDS_WG_ALLOWED_IPS=10.0.0.0/24
GYDS_WG_MTU=1420

# ─── Token Pricing ────────────────────────────────────────
GYDS_GYD_PEGGED=true
GYDS_GYD_PRICE=1.0
GYDS_TOKEN_PRICE=0.0000001

# ─── API / Admin ──────────────────────────────────────────
GYDS_API_PORT=3030
GYDS_API_KEY=your-api-key-here
GYDS_ADMIN_WALLET=0x6422d12bfaddee5142bfad21b3006a74d09017b1
GYDS_FOUNDER_WALLET=0x0000000000000000000000000000000000000001

# ─── SSL / Domain ─────────────────────────────────────────
GYDS_DOMAIN=netlifegy.com
GYDS_SSL_EMAIL=admin@netlifegy.com

# ─── Docker / Deployment ─────────────────────────────────
POSTGRES_PASSWORD=your-database-password
POSTGRES_DB=gydschain
POSTGRES_USER=gyds
REDIS_URL=redis://localhost:6379
EXPLORER_PORT=3000
NODE_PORT=30303

# ─── P2P Network ─────────────────────────────────────────
GYDS_P2P_PORT=30303
GYDS_BOOTNODES=
GYDS_NAT_TYPE=any

# ─── Security / Firewall ─────────────────────────────────
GYDS_FAIL2BAN_ENABLED=true
GYDS_FAIL2BAN_MAX_RETRIES=5
GYDS_FAIL2BAN_BAN_TIME=3600
GYDS_UFW_ENABLED=true

# ─── External Services (optional) ────────────────────────
# Uncomment and fill if using third-party integrations
# RESEND_API_KEY=re_xxxxxxxxxxxx
# COINGECKO_API_KEY=
# INFURA_API_KEY=
# TELEGRAM_BOT_TOKEN=
