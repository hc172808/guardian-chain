# ============================================================
# GYDSchain Self-Hosting Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control!
# ============================================================

# ─── Supabase / Database ──────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ─── Blockchain Node ──────────────────────────────────────
GYDS_RPC_ENDPOINT=https://rpc.netlifegy.com
GYDS_RPC_PORT=8545
GYDS_WS_ENDPOINT=wss://ws.netlifegy.com
GYDS_WS_PORT=8546
GYDS_CHAIN_ID=13370
GYDS_NODE_TYPE=fullnode
GYDS_DATA_DIR=/opt/gydschain/data
GYDS_STORAGE_SIZE_GB=50
GYDS_MAX_PEERS=100

# ─── Mining ───────────────────────────────────────────────
GYDS_MINING_ENABLED=false
GYDS_MINING_THREADS=4
GYDS_MINING_WALLET=0xYourMiningWalletAddress

# ─── WireGuard VPN ────────────────────────────────────────
GYDS_WG_PRIVATE_KEY=
GYDS_WG_PUBLIC_KEY=
GYDS_WG_SERVER_ENDPOINT=vpn.netlifegy.com
GYDS_WG_SERVER_PORT=51820
GYDS_WG_ALLOWED_IPS=10.0.0.0/24

# ─── Token Pricing ────────────────────────────────────────
GYDS_GYD_PEGGED=true
GYDS_GYD_PRICE=1.0
GYDS_TOKEN_PRICE=0.0000001

# ─── API / Admin ──────────────────────────────────────────
GYDS_API_PORT=3030
GYDS_API_KEY=your-api-key-here
GYDS_ADMIN_WALLET=0xYourAdminWalletAddress
GYDS_FOUNDER_WALLET=0x0000000000000000000000000000000000000001

# ─── SSL / Domain ─────────────────────────────────────────
GYDS_DOMAIN=netlifegy.com
GYDS_SSL_EMAIL=admin@netlifegy.com

# ─── Docker / Deployment ─────────────────────────────────
POSTGRES_PASSWORD=your-database-password
POSTGRES_DB=gydschain
REDIS_URL=redis://localhost:6379

# ─── External Services (optional) ────────────────────────
# Uncomment and fill if using third-party integrations
# RESEND_API_KEY=re_xxxxxxxxxxxx
# COINGECKO_API_KEY=
# INFURA_API_KEY=
