# ╔════════════════════════════════════════════════════════════════════════╗
# ║           GydsChain WireGuard Configuration v2.0                       ║
# ║           Domain: vpn.netlifegy.com | Chain ID: 198282                  ║
# ╚════════════════════════════════════════════════════════════════════════╝
#
# Instructions:
# 1. Generate keypair: wg genkey | tee privatekey | wg pubkey > publickey
# 2. Fill in your private key below (keep secret!)
# 3. Get your assigned IP and server public key from admin
# 4. Save as /etc/wireguard/wg0.conf (Linux) or equivalent
# 5. Start: wg-quick up wg0
#
# ─────────────────────────────────────────────────────────────────────────

[Interface]
# Your private key - NEVER SHARE THIS!
PrivateKey = YOUR_PRIVATE_KEY_HERE

# Your assigned VPN IP (get from admin)
Address = 10.0.0.100/32

# DNS servers
DNS = 1.1.1.1, 8.8.8.8

# MTU (optimize for your connection)
MTU = 1420

SaveConfig = false

# ─────────────────────────────────────────────────────────────────────────

[Peer]
# GydsChain VPN Server Public Key (get from admin)
PublicKey = SERVER_PUBLIC_KEY_HERE

# Pre-shared key for additional security (optional)
# PresharedKey = YOUR_PRESHARED_KEY_HERE

# Server endpoint
Endpoint = vpn.netlifegy.com:51820

# Internal node network
AllowedIPs = 10.0.0.0/24

# Keep alive (important for mobile/NAT)
PersistentKeepalive = 25

# ─────────────────────────────────────────────────────────────────────────
#
# ENVIRONMENT VARIABLES (for node.env):
#
# GYDS_WG_PRIVATE_KEY=your_private_key
# GYDS_WG_PUBLIC_KEY=your_public_key
# GYDS_WG_SERVER_ENDPOINT=vpn.netlifegy.com
# GYDS_WG_SERVER_PORT=51820
# GYDS_WG_SERVER_PUBKEY=server_public_key
# GYDS_WG_CLIENT_IP=10.0.0.100/32
# GYDS_WG_ALLOWED_IPS=10.0.0.0/24
#
# ─────────────────────────────────────────────────────────────────────────
#
# QUICK COMMANDS:
#
# Generate keypair:
#   wg genkey | tee privatekey | wg pubkey > publickey
#
# Start VPN:    wg-quick up wg0
# Stop VPN:     wg-quick down wg0
# Check status: wg show
#
# ─────────────────────────────────────────────────────────────────────────
