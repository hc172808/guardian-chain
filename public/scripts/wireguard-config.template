# ╔════════════════════════════════════════════════════════════════════════╗
# ║                    GYDSchain WireGuard Configuration                   ║
# ╚════════════════════════════════════════════════════════════════════════╝
#
# This is a template configuration file for WireGuard VPN connection
# to the GYDSchain network. Fill in the values and save as wg0.conf
#
# Instructions:
# 1. Fill in your private key (keep secret!)
# 2. Get your assigned IP from the admin
# 3. Get the server public key from the admin
# 4. Save this file as /etc/wireguard/wg0.conf (Linux) or appropriate location
# 5. Run: wg-quick up wg0
#
# ─────────────────────────────────────────────────────────────────────────

[Interface]
# Your private key - NEVER SHARE THIS!
# Generate with: wg genkey
PrivateKey = YOUR_PRIVATE_KEY_HERE

# Your assigned IP address on the VPN
# Format: 10.0.0.X/32 where X is assigned by admin
Address = 10.0.0.100/32

# DNS server (optional, for name resolution)
DNS = 1.1.1.1, 8.8.8.8

# Optional: Save config on wg-quick down
SaveConfig = false

# ─────────────────────────────────────────────────────────────────────────

[Peer]
# GYDSchain VPN Server Public Key
# Get this from the network admin
PublicKey = SERVER_PUBLIC_KEY_HERE

# Pre-shared key for additional security (optional)
# Generate with: wg genpsk
# PresharedKey = YOUR_PRESHARED_KEY_HERE

# Server endpoint
Endpoint = vpn.gydschain.io:51820

# Networks accessible through this VPN
# This allows access to the internal GYDSchain node network
AllowedIPs = 10.0.0.0/24

# Keep connection alive (important for mobile/NAT)
PersistentKeepalive = 25

# ─────────────────────────────────────────────────────────────────────────
# 
# ENVIRONMENT VARIABLES (for use in .env file):
#
# GYDS_WG_PRIVATE_KEY=your_private_key
# GYDS_WG_PUBLIC_KEY=your_public_key  
# GYDS_WG_SERVER_ENDPOINT=vpn.gydschain.io
# GYDS_WG_SERVER_PORT=51820
# GYDS_WG_SERVER_PUBKEY=server_public_key
# GYDS_WG_CLIENT_IP=10.0.0.100/32
# GYDS_WG_ALLOWED_IPS=10.0.0.0/24
#
# ─────────────────────────────────────────────────────────────────────────
#
# QUICK COMMANDS:
#
# Generate keypair:
#   wg genkey | tee privatekey | wg pubkey > publickey
#
# Start VPN:
#   wg-quick up wg0
#
# Stop VPN:
#   wg-quick down wg0
#
# Check status:
#   wg show
#
# ─────────────────────────────────────────────────────────────────────────
