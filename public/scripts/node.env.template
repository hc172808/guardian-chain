# ╔════════════════════════════════════════════════════════════════════════╗
# ║        GydsChain Node Environment Configuration v2.0                   ║
# ║        Domain: netlifegy.com | Chain ID: 13370                         ║
# ╚════════════════════════════════════════════════════════════════════════╝
#
# Copy this file to your node config directory and fill in values.
# All values are required unless marked as (optional)
#
# ─────────────────────────────────────────────────────────────────────────
#                              CHAIN CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Chain ID (do not change)
GYDS_CHAIN_ID="13370"

# Chain name
GYDS_CHAIN_NAME="GydsChain Mainnet"

# ─────────────────────────────────────────────────────────────────────────
#                              RPC CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Primary RPC endpoint
GYDS_RPC_PRIMARY="https://rpc.netlifegy.com"

# Failover RPC endpoints
GYDS_RPC_FAILOVER="https://rpc2.netlifegy.com,https://rpc3.netlifegy.com"

# Local RPC endpoints (non-SSL for local nodes)
GYDS_RPC_LOCAL="http://localhost:8546"
# LAN endpoint — set this to your server's LAN IP:port (e.g. http://192.168.x.x:8546)
# Leave blank if you do not have a LAN node.
GYDS_RPC_LAN=""

# WebSocket endpoint
GYDS_WS_ENDPOINT="wss://ws.netlifegy.com"

# RPC port for local access
GYDS_RPC_PORT="8546"

# ─────────────────────────────────────────────────────────────────────────
#                              NODE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Node type: "litenode", "fullnode", "validator", "rpc"
GYDS_NODE_TYPE="litenode"

# Data directory
GYDS_DATA_DIR="$HOME/.gydschain/data"

# Storage size in GB (min 5 for litenode, 100+ for fullnode)
GYDS_STORAGE_SIZE_GB="10"

# Maximum peer connections
GYDS_MAX_PEERS="50"

# P2P port
GYDS_P2P_PORT="30303"

# Log level: debug, info, warn, error
GYDS_LOG_LEVEL="info"

# Log file
GYDS_LOG_FILE="$HOME/.gydschain/logs/node.log"

# ─────────────────────────────────────────────────────────────────────────
#                            MINING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Enable mining (true/false)
GYDS_MINING_ENABLED="false"

# Mining threads (recommended: CPU cores - 1)
GYDS_MINING_THREADS="2"

# Wallet address for mining rewards
GYDS_MINING_WALLET="0xYOUR_WALLET_ADDRESS_HERE"

# ─────────────────────────────────────────────────────────────────────────
#                          WIREGUARD CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# WireGuard private key (KEEP SECRET!)
GYDS_WG_PRIVATE_KEY=""

# WireGuard public key (share with admin)
GYDS_WG_PUBLIC_KEY=""

# VPN server
GYDS_WG_SERVER_ENDPOINT="vpn.netlifegy.com"
GYDS_WG_SERVER_PORT="51820"

# Server public key (get from admin)
GYDS_WG_SERVER_PUBKEY=""

# Assigned VPN IP (get from admin)
GYDS_WG_CLIENT_IP="10.0.0.100/32"

# Allowed VPN networks
GYDS_WG_ALLOWED_IPS="10.0.0.0/24"

# ─────────────────────────────────────────────────────────────────────────
#                           TOKEN CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# GYD stablecoin peg
GYDS_GYD_PEGGED="true"
GYDS_GYD_PRICE="1.0"

# GYDS token price
GYDS_TOKEN_PRICE="0.0000001"

# ─────────────────────────────────────────────────────────────────────────
#                            API CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Local API server port
GYDS_API_PORT="3030"

# API key for authenticated endpoints (optional)
GYDS_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────
#                         SECURITY CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Rate limiting
GYDS_RATE_LIMIT_RPC="100"
GYDS_RATE_LIMIT_WINDOW="60"
GYDS_MAX_CONNECTIONS="200"

# ─────────────────────────────────────────────────────────────────────────
#                          ADMIN CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Admin wallet (for fullnode operators)
GYDS_ADMIN_WALLET=""

# Founder wallet (pre-configured)
GYDS_FOUNDER_WALLET="0x0000000000000000000000000000000000000001"

# ─────────────────────────────────────────────────────────────────────────
#                          SERVICE ENDPOINTS REFERENCE
# ─────────────────────────────────────────────────────────────────────────
#
# rpc.netlifegy.com         - Main RPC endpoint
# rpc2.netlifegy.com        - Backup RPC #1
# rpc3.netlifegy.com        - Backup RPC #2
# ws.netlifegy.com          - WebSocket endpoint
# explorer.netlifegy.com    - Block explorer
# vpn.netlifegy.com         - WireGuard VPN server
# testnet-rpc.netlifegy.com - Testnet RPC
# localhost:8546             - Local RPC
# (set GYDS_RPC_LAN)         - Optional LAN RPC (your local server IP:8546)
#
# ─────────────────────────────────────────────────────────────────────────
