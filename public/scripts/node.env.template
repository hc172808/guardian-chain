# ╔════════════════════════════════════════════════════════════════════════╗
# ║        GYDSchain Node Environment Configuration - netlifegy.com       ║
# ╚════════════════════════════════════════════════════════════════════════╝
#
# Copy this file to ~/.gydschain/config.env and fill in your values
# All values are required unless marked as (optional)
#
# ─────────────────────────────────────────────────────────────────────────
#                              RPC CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Primary RPC endpoint (main)
GYDS_RPC_ENDPOINT="https://rpc.netlifegy.com"

# Backup RPC endpoints (failover — if main goes down)
GYDS_RPC_BACKUP_1="https://rpc2.netlifegy.com"
GYDS_RPC_BACKUP_2="https://rpc3.netlifegy.com"

# Local RPC endpoints
GYDS_RPC_LOCAL="https://localhost:8546"
GYDS_RPC_LAN="https://192.168.18.106:8546"

# All RPC endpoints comma-separated (for scripts that need a list)
GYDS_RPC_ALL="https://rpc.netlifegy.com,https://rpc2.netlifegy.com,https://rpc3.netlifegy.com,https://localhost:8546,https://192.168.18.106:8546"

# RPC port for local API access
GYDS_RPC_PORT="8545"

# WebSocket endpoint for real-time updates
GYDS_WS_ENDPOINT="wss://ws.netlifegy.com"

# WebSocket port
GYDS_WS_PORT="8546"

# ─────────────────────────────────────────────────────────────────────────
#                              NODE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Node type: "litenode" or "fullnode"
GYDS_NODE_TYPE="litenode"

# Data directory for blockchain data
GYDS_DATA_DIR="$HOME/.gydschain/data"

# Storage size in GB (minimum 5 for litenode, 100+ for fullnode)
GYDS_STORAGE_SIZE_GB="10"

# Maximum number of peer connections
GYDS_MAX_PEERS="50"

# ─────────────────────────────────────────────────────────────────────────
#                            MINING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Enable mining (true/false)
GYDS_MINING_ENABLED="false"

# Number of mining threads (recommended: CPU cores - 1)
GYDS_MINING_THREADS="2"

# Wallet address to receive mining rewards
GYDS_MINING_WALLET="0xYOUR_WALLET_ADDRESS_HERE"

# ─────────────────────────────────────────────────────────────────────────
#                          WIREGUARD CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Your WireGuard private key (KEEP SECRET!)
# Generate with: wg genkey
GYDS_WG_PRIVATE_KEY=""

# Your WireGuard public key (share with admin)
# Generate with: echo $PRIVATE_KEY | wg pubkey
GYDS_WG_PUBLIC_KEY=""

# VPN server endpoint
GYDS_WG_SERVER_ENDPOINT="vpn.netlifegy.com"

# VPN server port
GYDS_WG_SERVER_PORT="51820"

# Server's public key (get from admin)
GYDS_WG_SERVER_PUBKEY=""

# Your assigned VPN IP address (get from admin)
GYDS_WG_CLIENT_IP="10.0.0.100/32"

# Networks accessible through VPN
GYDS_WG_ALLOWED_IPS="10.0.0.0/24"

# ─────────────────────────────────────────────────────────────────────────
#                           TOKEN CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# GYD stablecoin peg enabled (true = pegged to USD)
GYDS_GYD_PEGGED="true"

# GYD price in USD (only used if GYDS_GYD_PEGGED=false)
GYDS_GYD_PRICE="1.0"

# GYDS token price (usually fetched from network)
GYDS_TOKEN_PRICE="0.0000001"

# ─────────────────────────────────────────────────────────────────────────
#                            API CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Local API server port
GYDS_API_PORT="3030"

# API key for authenticated endpoints (optional)
GYDS_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────
#                          ADMIN CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Admin wallet address (for fullnode operators)
GYDS_ADMIN_WALLET=""

# Founder wallet address (pre-configured)
GYDS_FOUNDER_WALLET="0x0000000000000000000000000000000000000001"

# ─────────────────────────────────────────────────────────────────────────
#                          CHAIN CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Chain ID (do not change)
GYDS_CHAIN_ID="13370"

# Chain name
GYDS_CHAIN_NAME="GYDSchain Mainnet"

# Block explorer URL
GYDS_EXPLORER_URL="https://explorer.netlifegy.com"

# Main website
GYDS_WEBSITE="https://netlifegy.com"

# ─────────────────────────────────────────────────────────────────────────
#                          SERVICE ENDPOINTS REFERENCE
# ─────────────────────────────────────────────────────────────────────────
#
# rpc.netlifegy.com         - Main RPC endpoint
# rpc2.netlifegy.com        - Backup RPC #1
# rpc3.netlifegy.com        - Backup RPC #2
# ws.netlifegy.com          - WebSocket endpoint
# explorer.netlifegy.com    - Block explorer
# vpn.netlifegy.com         - WireGuard VPN server
# testnet-rpc.netlifegy.com - Testnet RPC
# localhost:8546             - Local RPC
# 192.168.18.106:8546        - LAN RPC
#
# ─────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────
#                           LOGGING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Log level: debug, info, warn, error
GYDS_LOG_LEVEL="info"

# Log file location
GYDS_LOG_FILE="$HOME/.gydschain/logs/node.log"

# ─────────────────────────────────────────────────────────────────────────
# END OF CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
