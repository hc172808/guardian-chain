# GydsChain Node Dockerfile v2.2.0
# Supports: validator, fullnode, rpc, litenode modes
# Includes: security hardening, health checks, fail2ban
#
# PREREQUISITE: Place your Go source in blockchain-go/ at the project root.
#   blockchain-go/go.mod
#   blockchain-go/go.sum
#   blockchain-go/cmd/fullnode/main.go
#   blockchain-go/cmd/litenode/main.go
#
# Build from project root:
#   docker build -f public/docker/Dockerfile.node -t gyds-node .
#
# Or via docker compose (run from project root):
#   INDEXER_DB_PASSWORD=$(openssl rand -hex 16) docker compose -f public/docker/docker-compose.yml up -d

ARG GO_SOURCE_DIR=blockchain-go

FROM golang:1.22-alpine AS builder

RUN apk add --no-cache git gcc musl-dev leveldb-dev make

WORKDIR /app

ARG GO_SOURCE_DIR
COPY ${GO_SOURCE_DIR}/go.mod ${GO_SOURCE_DIR}/go.sum ./
RUN go mod download

COPY ${GO_SOURCE_DIR}/ .
RUN CGO_ENABLED=1 go build -ldflags="-s -w" -o /gydsd ./cmd/fullnode/main.go
RUN CGO_ENABLED=1 go build -ldflags="-s -w" -o /litenode ./cmd/litenode/main.go

FROM alpine:3.20

RUN apk add --no-cache \
    ca-certificates \
    leveldb \
    wireguard-tools \
    iptables \
    ip6tables \
    fail2ban \
    curl \
    jq \
    tini

COPY --from=builder /gydsd /usr/local/bin/gydsd
COPY --from=builder /litenode /usr/local/bin/litenode

# Create non-root user
RUN addgroup -S gydschain && adduser -S gydschain -G gydschain

# Default data and log directories
RUN mkdir -p /var/lib/gydschain /var/log/gydschain /etc/gydschain \
    && chown -R gydschain:gydschain /var/lib/gydschain /var/log/gydschain /etc/gydschain

# Fail2Ban config for RPC brute-force protection
RUN mkdir -p /etc/fail2ban/jail.d && \
    printf '[gyds-rpc]\nenabled = true\nmaxretry = 10\nbantime = 3600\nfindtime = 300\n' \
    > /etc/fail2ban/jail.d/gyds-rpc.conf

EXPOSE 8545 8546 30303 30303/udp 51820/udp

ENV NODE_TYPE=fullnode
ENV DATA_DIR=/var/lib/gydschain
ENV RPC_PORT=8546
ENV P2P_PORT=30303
ENV MAX_PEERS=50
ENV STORAGE_GB=100
ENV CHAIN_ID=13370
ENV LOG_LEVEL=info

USER gydschain

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -sf "http://localhost:${RPC_PORT}/health" || exit 1

ENTRYPOINT ["tini", "--"]
CMD ["sh", "-c", \
  "if [ \"$NODE_TYPE\" = 'litenode' ]; then \
    exec litenode \
      --rpc=${RPC_URL:-https://rpc.netlifegy.com} \
      --rpc-failover=${RPC_FAILOVER:-https://rpc2.netlifegy.com,https://rpc3.netlifegy.com} \
      --ws=${WS_URL:-wss://ws.netlifegy.com} \
      --datadir=$DATA_DIR \
      --chain-id=$CHAIN_ID \
      --log-level=$LOG_LEVEL; \
  else \
    exec gydsd \
      --datadir=$DATA_DIR \
      --rpcport=$RPC_PORT \
      --p2pport=$P2P_PORT \
      --maxpeers=$MAX_PEERS \
      --storage=$STORAGE_GB \
      --chain-id=$CHAIN_ID \
      --log-level=$LOG_LEVEL; \
  fi"]
