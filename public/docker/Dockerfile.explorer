# GydsChain Explorer + Dashboard Dockerfile v2.2.0
# Multi-stage build with security hardening
# Domain: netlifegy.com | Chain ID: 198282
#
# Build from project root:
#   docker build -f public/docker/Dockerfile.explorer -t gyds-explorer .
#
# Requires env vars at build time:
#   VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY, VITE_SUPABASE_PROJECT_ID

FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies (use package-lock.json for reproducible builds)
COPY package.json package-lock.json ./
RUN npm ci --production=false

# Copy source and build
COPY . .

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_SUPABASE_PROJECT_ID

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY
ENV VITE_SUPABASE_PROJECT_ID=$VITE_SUPABASE_PROJECT_ID

RUN npm run build

# Production stage with hardened Nginx
FROM nginx:1.27-alpine

# Security: remove defaults, add curl for health checks
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf && \
    apk add --no-cache curl

# Copy built app and nginx config
COPY --from=builder /app/dist /usr/share/nginx/html
COPY public/docker/nginx.conf /etc/nginx/conf.d/default.conf

# Security: correct ownership and permissions
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
