# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  GYDSchain Dashboard — Shared Environment Configuration                 ║
# ║                                                                          ║
# ║  HOW TO USE:                                                             ║
# ║    cp .env.template .env                                                 ║
# ║    Fill in the values marked REQUIRED or ask the team lead for them.    ║
# ║                                                                          ║
# ║  This file IS committed to git so all teammates share the same config.  ║
# ║  The .env file (with real secrets) is in .gitignore — never commit it.  ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ─── PostgreSQL Database (SHARED — everyone uses this) ───────────────────────
# REQUIRED: Ask your team lead for this connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example (Replit managed): set via Replit Secrets as DATABASE_URL
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/gydschain

# ─── Session Secret ───────────────────────────────────────────────────────────
# REQUIRED: Must be the same on all servers (sessions break if different).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_USE_SAME_VALUE_ON_ALL_SERVERS

# ─── App Environment ──────────────────────────────────────────────────────────
NODE_ENV=development
# Set to "production" on live servers

# ─── GYDSchain Network ────────────────────────────────────────────────────────
GYDS_CHAIN_ID=13370

# Primary RPC endpoint (your running full node or hosted RPC)
GYDS_RPC_URL=https://rpc.netlifegy.com

# Backup RPC endpoints (comma-separated, used if primary is down)
GYDS_RPC_BACKUP_1=https://rpc2.netlifegy.com
GYDS_RPC_BACKUP_2=https://rpc3.netlifegy.com

# WebSocket endpoint
GYDS_WS_URL=wss://ws.netlifegy.com

# ─── Admin / Founder Wallets ──────────────────────────────────────────────────
# REQUIRED: The 0x wallet addresses for the admin and founder accounts
ADMIN_WALLET=0xYOUR_ADMIN_WALLET_ADDRESS
FOUNDER_WALLET=0xYOUR_FOUNDER_WALLET_ADDRESS

# ─── Default Account Passwords ────────────────────────────────────────────────
# Override the auto-created founder/admin account passwords on first boot.
# Leave blank to use the defaults (see README).
FOUNDER_PASSWORD=
ADMIN_PASSWORD=

# ─── Ports ────────────────────────────────────────────────────────────────────
PORT=5001
VITE_PORT=5000

# ─── Vite Frontend Variables (prefix with VITE_ to expose to browser) ─────────
# Local RPC override for dev (optional)
VITE_LOCAL_RPC_URL=

# ─── GitHub (for node installer scripts / private repo access) ────────────────
# Personal Access Token with repo read access
GITHUB_TOKEN=

# ─── WireGuard VPN (optional — only needed if running VPN-connected nodes) ────
GYDS_WG_PRIVATE_KEY=
GYDS_WG_SERVER_ENDPOINT=vpn.netlifegy.com:51820
GYDS_WG_ALLOWED_IPS=10.0.0.0/24

# ─── Telegram Bot (optional — for admin alerts) ───────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── WhatsApp / Email (optional) ─────────────────────────────────────────────
WHATSAPP_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Web Push Notifications (optional) ───────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@netlifegy.com

# ─── Mining (optional — only for nodes running with mining enabled) ───────────
GYDS_MINING_ENABLED=false
GYDS_MINING_THREADS=4
GYDS_MINING_WALLET=

# ─── Faucet (optional) ────────────────────────────────────────────────────────
FAUCET_AMOUNT=10
FAUCET_COOLDOWN_HOURS=24

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
