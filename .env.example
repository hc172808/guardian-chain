# ─── GYDSchain Ecosystem — Environment Variable Reference ─────────────────────
#
# HOW TO USE ON REPLIT:
#   Secrets (keys, passwords, tokens) → add via the lock icon in the sidebar.
#   Safe defaults (ports, modes, paths) → already set; edit .env.local if needed.
#
# HOW TO USE LOCALLY (outside Replit):
#   Copy this file to .env, fill in the blanks, and never commit it.
#     cp .env.example .env

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000                        # Explorer / main app port

# ── API Server (artifacts/api-server) ────────────────────────────────────────
API_PORT=8080
LOG_LEVEL=info                   # trace | debug | info | warn | error

# Object storage paths (optional; leave blank to use defaults)
PRIVATE_OBJECT_DIR=./data/private
PUBLIC_OBJECT_SEARCH_PATHS=./data/public

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=                    # *** Replit Secret *** postgres://user:pass@host/db

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → Your App → API Keys
CLERK_SECRET_KEY=                # *** Replit Secret *** sk_test_...
CLERK_PUBLISHABLE_KEY=           # *** Replit Secret *** pk_test_...

# Explorer frontend (must be prefixed VITE_ to be exposed to the browser)
VITE_CLERK_PUBLISHABLE_KEY=      # *** Replit Secret *** same pk_test_ value
VITE_CLERK_PROXY_URL=            # Optional: only needed if using Clerk proxy/satellite

# ── Blockchain Explorer (artifacts/blockchain-explorer) ───────────────────────
VITE_MINING_RPC_ENDPOINT=http://localhost:8545   # Points to GYDS litenode RPC

# ── GYDS Litenode (artifacts/gyds-litenode) ───────────────────────────────────
GYDS_CHAIN_ID=1337
GYDS_NODE_MODE=lite              # lite | full | archive
GYDS_RPC_PORT=8545               # JSON-RPC port (do NOT use 5000 or 8080)
GYDS_RPC_HOST=0.0.0.0
GYDS_P2P_PORT=30303
GYDS_DATA_DIR=./data
GYDS_LOG_LEVEL=info              # debug | info | warn | error
GYDS_BOOTSTRAP_NODES=            # Optional: comma-separated enode:// URLs

# ── Mobile Wallet (artifacts/chaincore-mobile) ────────────────────────────────
# Expo reads EXPO_PUBLIC_* variables at build time
EXPO_PUBLIC_DOMAIN=              # Set automatically by Replit
EXPO_PUBLIC_REPL_ID=             # Set automatically by Replit
